# ================================================
#  نموذج المتغيرات — انسخه إلى .env عند التشغيل محليًا
#  على Railway: لا تحتاج هذا الملف، ضع القيم في Variables
#  لا ترفع ملف .env إلى GitHub أبدًا
# ================================================

# --- مفاتيح Alpaca ---
# استخدم مفاتيح الحساب التجريبي مع PAPER_TRADING=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- وضع التشغيل ---
# true = تجريبي | false = حقيقي
# ⚠️ المفاتيح يجب أن تكون من نفس البيئة (تجريبية أو حقيقية)
PAPER_TRADING=true

# --- مصدر البيانات ---
# iex = مجاني (يرى جزءًا صغيرًا من السوق) | sip = اشتراك مدفوع (كامل السوق)
DATA_FEED=iex

# --- قائمة المراقبة ---
# الرموز مفصولة بفواصل. اتركه فارغًا لاستخدام القائمة الافتراضية في config.py
WATCHLIST=

# --- فلترة الأسهم ---
MIN_PRICE=1.50
MAX_PRICE=16.00
# نافذة حساب الزخم بالدقائق
MOMENTUM_WINDOW_MIN=5
# أقل ارتفاع مطلوب خلال النافذة (٪)
MIN_MOMENTUM_PCT=3.0
# حجم آخر 10 دقائق. على بيانات iex المجانية ابقِه صغيرًا
MIN_VOLUME_10M=20000
# أقصى فرق بين العرض والطلب (٪)
MAX_SPREAD_PCT=0.60

# --- الحجم والمخاطرة ---
# ميزانية الصفقة الواحدة بالدولار
TRADE_BUDGET_USD=25
# لا صفقة أقل من هذا المبلغ
MIN_BUDGET_USD=10
# أقصى خسارة مقبولة بالدولار في الصفقة الواحدة
RISK_PER_TRADE_USD=1
MAX_OPEN_POSITIONS=2
# حد الخسارة اليومية (٪) الذي يفعّل الإيقاف الطارئ
MAX_DAILY_LOSS_PCT=2.0
# أقصى عدد صفقات شراء في اليوم
MAX_TRADES_PER_DAY=6
# فترة الانتظار بعد البيع قبل إعادة شراء نفس السهم (دقائق)
SYMBOL_COOLDOWN_MIN=60

# --- الخروج ---
TAKE_PROFIT_PCT=4.5
STOP_LOSS_PCT=2.5
# أوامر الشراء المعلّقة التي لم تُنفَّذ تُلغى بعد هذه المدة (ثوانٍ)
ENTRY_TIMEOUT_SEC=90

# --- المحرك ---
SCAN_INTERVAL_SEC=30
# true = التداول في الجلسة الممتدة | false = الجلسة الرسمية فقط
TRADE_EXTENDED_HOURS=true

# --- قاعدة البيانات ---
# على Railway ضع: /data/bot_state.db (بعد إضافة Volume)
DB_PATH=bot_state.db

# --- تليجرام ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook (TradingView) ---
# كلمة سر طويلة عشوائية — بدونها يرفض البوت كل الأوامر
WEBHOOK_PASSPHRASE=

# --- المنفذ ---
# Railway يحدده تلقائيًا؛ لا تغيّره إلا للتشغيل المحلي
PORT=8080
