# ================================================
#  نموذج المتغيرات — انسخه إلى .env عند التشغيل محليًا
#  على Railway: لا تحتاج هذا الملف، ضع القيم في Variables
#  لا ترفع ملف .env إلى GitHub أبدًا
# ================================================

# --- مفاتيح Alpaca ---
# استخدم مفاتيح الحساب التجريبي مع PAPER_TRADING=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- وضع التشغيل ---
# true = تجريبي | false = حقيقي
# ⚠️ المفاتيح يجب أن تكون من نفس البيئة (تجريبية أو حقيقية)
PAPER_TRADING=true

# --- مصدر البيانات ---
# iex = مجاني (يرى جزءًا صغيرًا من السوق) | sip = اشتراك مدفوع (كامل السوق)
DATA_FEED=iex

# --- قائمة المراقبة ---
# الرموز مفصولة بفواصل. ABTE و DBRG حُذفا لأنهما بلا بيانات أسعار
WATCHLIST=MOBX

# --- فلترة الأسهم ---
MIN_PRICE=5.0
MAX_PRICE=50.0
MAX_SPREAD_PCT=1.0
# على بيانات iex المجانية خفّض هذا الرقم كثيرًا (مثلاً 50000)
MIN_VOLUME=500000

# --- إدارة المخاطر ---
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=2.5
TAKE_PROFIT_PCT=5.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_TRADES=6
MAX_POSITION_VALUE_PCT=25.0
DAILY_LOSS_LIMIT_PCT=3.0
COOLDOWN_MINUTES=30

# --- المحرك ---
SCAN_INTERVAL_SECONDS=30
ORDER_TIMEOUT_SECONDS=120

# --- قاعدة البيانات ---
# على Railway ضع: /data/bot_state.db (بعد إضافة Volume)
DB_PATH=bot_state.db

# --- تليجرام ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook (TradingView) ---
# كلمة سر طويلة عشوائية — بدونها يرفض البوت كل الأوامر
WEBHOOK_PASSPHRASE=

# --- المنفذ ---
# Railway يحدده تلقائيًا؛ لا تغيّره إلا للتشغيل المحلي
PORT=8080
